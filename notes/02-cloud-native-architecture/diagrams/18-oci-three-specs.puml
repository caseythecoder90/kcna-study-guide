@startuml
!include ../../../tools/diagrams/kcna-theme.puml
title Open Container Initiative — three specifications, one pipeline

rectangle "image-spec\n<size:11>how a filesystem is bundled into an image:</size>\n<size:11>manifest · config · layers (tar) · index</size>" <<accent>> as img
rectangle "distribution-spec\n<size:11>the registry API for pushing and pulling images;</size>\n<size:11>built on the Docker Registry HTTP API v2</size>" <<accent>> as dist
rectangle "runtime-spec\n<size:11>how to run a filesystem bundle unpacked on disk:</size>\n<size:11>config.json + rootfs → namespaces, cgroups, process</size>" <<accent>> as rt

rectangle "Build tools" <<group>> as build {
  rectangle "Docker / BuildKit" <<plain>> as b1
  rectangle "Podman / Buildah" <<plain>> as b2
  b1 -[hidden]right-> b2
}
rectangle "Registries" <<group>> as reg {
  rectangle "Docker Hub · Harbor · GHCR\n<size:11>ECR · GCR · Quay</size>" <<plain>> as r1
}
rectangle "OCI runtimes" <<groupGood>> as runtimes {
  rectangle "runc\n<size:11>reference implementation,</size>\n<size:11>donated by Docker (Go)</size>" <<good>> as runc
  rectangle "crun\n<size:11>Red Hat, C</size>" <<plain>> as crun
  rectangle "gVisor (runsc)\n<size:11>user-space kernel</size>" <<plain>> as gvisor
  rectangle "Kata Containers\n<size:11>each pod in a micro-VM</size>\n<size:11>(QEMU / Firecracker)</size>" <<plain>> as kata
  runc -[hidden]right-> crun
  crun -[hidden]right-> gvisor
  gvisor -[hidden]right-> kata
}

build -down-> img : produce
img -right-> dist : push / pull
dist -right-> rt : download image,\nunpack to a bundle
rt -down-> runtimes : run the bundle
reg -up-> dist : implement

caption <i>Established June 2015 under the Linux Foundation by Docker, CoreOS and others: an open governance structure for open industry standards around container formats and runtimes.</i>\n<i>Because all three are open, any builder's image runs on any runtime from any registry — that portability is the whole point.</i>
@enduml
