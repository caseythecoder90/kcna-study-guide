@startuml
!include ../../../tools/diagrams/kcna-theme.puml
title What actually runs on a node: boxes are PROGRAMS, arrows are the STANDARDS between them

rectangle "kubelet\n<size:11>long-running daemon (systemd) · one per node</size>\n<size:11>decides WHAT should run; never creates a container itself</size>" <<accent>> as kubelet

rectangle "containerd\n<size:11>long-running daemon · one per node</size>\n<size:11>its built-in CRI plugin = the server side of CRI</size>\n<size:11>pulls images · unpacks layers (snapshotter) · writes OCI bundles</size>" <<good>> as ctd

rectangle "CNI plugin\n<size:11>a plain executable, e.g. /opt/cni/bin/calico</size>\n<size:11>runs for a moment, then EXITS</size>" <<plain>> as cni

rectangle "Registry\n<size:11>Docker Hub, GHCR, ECR</size>" <<muted>> as reg

rectangle "containerd-shim-runc-v2\n<size:11>long-running · ONE PER POD</size>\n<size:11>parent of the Pod's processes: keeps their stdio + logs,</size>\n<size:11>collects exit codes, survives a containerd restart</size>" <<good>> as shim

rectangle "runc\n<size:11>a CLI binary · runs for each create/start, then EXITS</size>\n<size:11>reads config.json, builds namespaces + cgroups, execs the process</size>" <<plain>> as runc

rectangle "The Pod's processes (children of the shim)" <<groupGood>> as pod {
  rectangle "pause\n<size:11>PID 1 of the sandbox · holds the</size>\n<size:11>network, IPC, UTS namespaces open</size>" <<good>> as pause
  rectangle "app container(s)\n<size:11>e.g. nginx master + workers</size>\n<size:11>JOIN pause's namespaces</size>" <<good>> as app
  pause -[hidden]right-> app
}

kubelet -down-> ctd : CRI\ngRPC over unix:///run/containerd/containerd.sock\nRunPodSandbox · PullImage · CreateContainer · StartContainer
ctd -right-> reg : OCI distribution-spec\n(HTTPS pull)
ctd -left-> cni : CNI spec\nexec with JSON on stdin\nADD → eth0 + IP
ctd -down-> shim : ttrpc (shim API)\nover a per-shim socket
shim -down-> runc : OCI runtime-spec\nexec "runc create" / "runc start"\n+ bundle: config.json + rootfs
runc -down-> pod : clone() + exec\n(kernel: namespaces, cgroups)

caption <i>Swap the implementations, keep the standards: CRI-O replaces containerd (with one conmon per container instead of the shim); crun, gVisor or Kata replace runc (picked per Pod by RuntimeClass).</i>
@enduml
