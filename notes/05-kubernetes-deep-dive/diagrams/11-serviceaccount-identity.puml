@startuml
!include ../../../tools/diagrams/kcna-theme.puml
title A Pod always has an identity — the only question is which one

rectangle "You write a Pod" <<group>> as top {
  rectangle "NO serviceAccountName\n<size:11>spec:</size>\n<size:11>  containers: [...]</size>" <<plain>> as p1
  rectangle "WITH serviceAccountName\n<size:11>spec:</size>\n<size:11>  serviceAccountName: build-robot</size>\n<size:11>  containers: [...]</size>" <<plain>> as p2
  p1 -[hidden]right-> p2
}

rectangle "Kubernetes assigns one either way" <<group>> as sas {
  rectangle "the 'default' ServiceAccount\nof THAT namespace" <<good>> as sa1
  rectangle "the named ServiceAccount\nof THAT namespace" <<accent>> as sa2
  sa1 -[hidden]right-> sa2
}

rectangle "The kubelet mounts a projected, auto-rotating token (v1.22 and later)" <<group>> as mount {
  rectangle "/var/run/secrets/kubernetes.io/serviceaccount/\n<size:11>token       — a signed JWT, short-lived, rotated by the kubelet before it expires</size>\n<size:11>ca.crt      — the cluster CA, so the Pod can verify the API server</size>\n<size:11>namespace   — which namespace this Pod is in</size>\n\n<size:11>Opt out with automountServiceAccountToken: false on the Pod or on the ServiceAccount.</size>" <<plain>> as m
}

rectangle "Authentication turns that token into the same three things a certificate produces" <<group>> as id {
  rectangle "username: system:serviceaccount:<b>NAMESPACE</b>:<b>NAME</b>\ngroups:   system:serviceaccounts\n          system:serviceaccounts:<b>NAMESPACE</b>\n          system:authenticated\n\n<size:11>A string and a set of strings. RBAC cannot tell it apart from a human.</size>" <<accent>> as i
}

rectangle "DEFAULT — almost nothing" <<groupBad>> as dflt {
  rectangle "The 'default' ServiceAccount gets NO permissions beyond the API discovery\nendpoints Kubernetes grants to every authenticated principal.\n\n<size:11>A Pod that says nothing can reach the API server, be told who it is, and do</size>\n<size:11>essentially nothing else. That is least privilege by default.</size>\n<size:11>Delete the object and the control plane simply recreates it.</size>" <<bad>> as db
}

rectangle "CUSTOM — whatever you bind to it" <<groupGood>> as cust {
  rectangle "kubectl create serviceaccount build-robot\nkubectl create rolebinding robot-reader ~-~-role=pod-reader ~-~-serviceaccount=default:build-robot\n\n<size:11>Only now can the Pod create a Pod, read a Secret, list Deployments...</size>\n<size:11>Unlike User and Group, a ServiceAccount subject MUST already exist and MUST carry a namespace.</size>" <<good>> as cb
}

top -down-> sas
sas -down-> mount
mount -down-> id
id -down-> dflt
dflt -[hidden]down-> cust

caption <i>The one KCNA fact: if a Pod does not name a ServiceAccount, it is assigned the 'default' ServiceAccount of its own namespace — and that account is deliberately powerless.</i>\n<i>Everything else is the RBAC of chapters 05-03 and 05-04. ServiceAccount is simply the third subject kind, and the only one that is a real Kubernetes object.</i>
@enduml
